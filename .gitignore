# Build output. Named exactly, because a bare /vibegiver would also exclude a
# directory of that name -- Vibe Killer came one slash from excluding its own
# embedded rule pack this way, and the binary it published had no rules in it.
/vibegiver
/vibegiver.exe

# Run artifacts: every fix attempt's logs, patches and verification output.
/runs/

# CI builds the binary here rather than using `go run`, which collapses every
# non-zero exit code to 1 and so hides the difference between "still open" and
# "contract refused".
/bin/
